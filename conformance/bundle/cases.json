      "path": "docs/specifications/2026-10-17-maplab-r1/examples/forest-export",
      "bundleSha256": "0a39dafd637c7cefa184ce9f18bd909d47f3eef317de3418bb3573614bf323ea",
      "maps": [
        "map.clearing",
        "map.forest"
      ],
      "portals": [
        {
          "from": "map.clearing",
          "to": {
            "mapId": "map.forest",
            "entityId": "checkpoint.east"
          }
        },
        {
          "from": "map.forest",
          "to": {
            "mapId": "map.clearing",
            "entityId": "start.arrival"
