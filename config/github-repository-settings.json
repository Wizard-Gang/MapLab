{
  "repository": "Wizard-Gang/MapLab",
  "status": "desired-policy; enforcement requires successful provider read-back",
  "defaultBranch": "main",
  "visibility": "public",
  "merge": {
    "allowSquashMerge": true,
    "allowMergeCommit": false,
    "allowRebaseMerge": true,
    "deleteBranchOnMerge": true
  },
  "main": {
    "requirePullRequest": true,
    "requireCurrentWithMain": true,
    "requiredChecks": [
      "verify",
      "change-id",
      "security"
    ],
    "requireExactHeadEvidence": true,
    "bypassActors": [],
    "allowDeletion": false,
    "allowNonFastForward": false,
    "requiredApprovingReviewCount": 0,
    "checksAppId": 15368,
    "allowedMergeMethods": [
      "rebase"
    ]
  },
  "release": {
    "pattern": "refs/heads/release/*",
    "requirePullRequest": true,
    "requiredChecks": [
      "gate",
      "change-id"
    ],
    "allowedMergeMethods": [
      "squash"
    ],
    "bypassActors": [],
    "allowDeletion": true,
    "allowNonFastForward": false
  },
  "tags": {
    "pattern": "v*",
    "immutable": true,
    "bypassActors": []
  },
  "releases": {
    "immutable": true
  },
  "deployment": "not configured or authorized"
}
