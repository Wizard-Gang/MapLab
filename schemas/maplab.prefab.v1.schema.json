          "$ref": "#/$defs/asset-scale"
        },
        "size": {
          "$ref": "#/$defs/asset-size"
        }
      },
      "required": [
        "id",
        "path",
        "mediaType",
        "wuPerAssetUnit",
        "size"
      ],
      "additionalProperties": false
    },
