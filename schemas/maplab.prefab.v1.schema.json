{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maplab:schema:maplab.prefab:1",
  "title": "maplab.prefab v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "maplab.prefab"
    },
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "maxLength": 256
    },
    "pivot": {
      "$ref": "#/$defs/vec"
    },
    "dependencies": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "layerSlots": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/key"
      },
      "uniqueItems": true
    },
    "content": {
      "$ref": "#/$defs/prefab-content"
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "name",
    "pivot",
    "dependencies",
    "layerSlots",
    "content"
  ],
  "additionalProperties": false,
