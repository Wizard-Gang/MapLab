      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "asset-extent": {
      "type": "number",
      "multipleOf": 0.0625,
      "minimum": 0,
      "maximum": 131072
    },
    "deferred-array": {
      "$comment": "Contents validated from ML-004 to ML-006; ML-003 checks only the JSON type.",
      "type": "array"
    },
    "deferred-object": {
      "$comment": "Contents validated from ML-004 to ML-006; ML-003 checks only the JSON type.",
      "type": "object"
    },
    "vec": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "$ref": "#/$defs/coordinate"
        }
