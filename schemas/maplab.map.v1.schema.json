        },
        "fill": {
          "$ref": "#/$defs/color"
        }
      },
      "required": [
        "kind",
        "shape",
        "fill"
      ],
      "additionalProperties": false
    },
    "frames-source": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "frames"
        },
        "assetIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "pivot": {
          "$ref": "#/$defs/vec"
        },
        "frameTicks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "loop": {
          "type": "boolean"
        }
      },
      "required": [
