            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "$ref": "#/$defs/alpha"
