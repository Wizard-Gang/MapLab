{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:maplab:schema:maplab.map:1",
  "title": "maplab.map v1: base and geometry subset",
  "description": "ML-003/004 R1 contracts. Closed base, geometry, layers, visuals, terrain and prefab provenance. Gameplay, catalog calls/conditions, camera, environment and navigation remain deferred to ML-006. Local references only.",
  "type": "object",
  "properties": {
    "format": {
      "const": "maplab.map"
    },
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "requiredFeatures": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/contract-ref"
      }
    },
    "coordinates": {
      "$ref": "#/$defs/coordinates"
    },
    "bounds": {
      "$ref": "#/$defs/rect"
    },
    "collisionContract": {
      "$ref": "#/$defs/contract-ref"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "presentations": {
      "$ref": "#/$defs/deferred-array"
    },
    "layers": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/layer"
      }
    },
    "terrain": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/terrain"
      }
    },
    "visuals": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/visual"
      }
    },
    "materials": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "bodies": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/body"
      }
    },
    "footholds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/foothold"
      }
    },
    "traversals": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/traversal"
      }
    },
    "regions": {
      "$ref": "#/$defs/deferred-array"
    },
    "entities": {
      "$ref": "#/$defs/deferred-array"
    },
    "waypoints": {
      "$ref": "#/$defs/deferred-array"
    },
    "routes": {
      "$ref": "#/$defs/deferred-array"
    },
    "triggers": {
      "$ref": "#/$defs/deferred-array"
    },
    "encounters": {
      "$ref": "#/$defs/deferred-array"
    },
    "camera": {
      "$ref": "#/$defs/deferred-object"
    },
    "environment": {
      "$ref": "#/$defs/deferred-object"
    },
    "navigation": {
      "$ref": "#/$defs/deferred-object"
    },
    "flags": {
      "$ref": "#/$defs/deferred-array"
    },
    "prefabPlacements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/prefab-placement"
      }
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "metadata",
    "requiredFeatures",
    "coordinates",
    "bounds",
    "collisionContract",
    "dependencies",
    "assets",
    "presentations",
    "layers",
    "terrain",
    "visuals",
    "materials",
    "bodies",
    "footholds",
    "traversals",
    "regions",
    "entities",
    "waypoints",
    "routes",
    "triggers",
    "encounters",
    "camera",
    "environment",
    "navigation",
    "flags",
    "prefabPlacements"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "description": "Persistent ID: unique across a map's object collections; document IDs unique across a bundle.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,95}$"
    },
    "key": {
      "description": "Catalog and contract key; same grammar as IDs.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,95}$"
    },
    "coordinate": {
      "description": "World units on the 1/16 WU quantum within ±131,072 WU (2^17).",
      "type": "number",
      "multipleOf": 0.0625,
      "minimum": -131072,
      "maximum": 131072
    },
    "length": {
      "description": "Positive length on the 1/16 WU quantum, at most 262,144 WU (2^18).",
      "type": "number",
      "multipleOf": 0.0625,
      "exclusiveMinimum": 0,
      "maximum": 262144
    },
    "rect": {
      "description": "x, y, width, height in WU; the far edges must also stay within range.",
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "$ref": "#/$defs/length"
        },
        {
          "$ref": "#/$defs/length"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "ticks": {
      "description": "Duration in integer ticks at the declared 60 Hz.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "path": {
      "description": "Bundle-root-relative POSIX path of portable filename characters; reserved device names and case aliases are semantic errors.",
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:/[A-Za-z0-9_](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
    },
    "contract-ref": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "key",
        "version"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096
        },
        "authors": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tags": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "required": [
        "name",
        "description",
        "authors",
        "license",
        "tags"
      ],
      "additionalProperties": false
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "units": {
          "const": "WU"
        },
        "x": {
          "const": "right"
        },
        "y": {
          "const": "down"
        },
        "rotation": {
          "const": "clockwiseDegrees"
        },
        "quantum": {
          "const": 0.0625
        },
        "ticksPerSecond": {
          "const": 60
        }
      },
      "required": [
        "units",
        "x",
        "y",
        "rotation",
        "quantum",
        "ticksPerSecond"
      ],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "map",
            "tileset",
            "prefab",
            "movement",
            "catalog",
            "riglab"
          ]
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "required"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "mediaType": {
          "enum": [
            "image/png",
            "image/webp",
            "image/svg+xml",
            "audio/ogg",
            "audio/wav"
          ]
        },
        "wuPerAssetUnit": {
          "$ref": "#/$defs/asset-scale"
        },
        "size": {
          "$ref": "#/$defs/asset-size"
        }
      },
      "required": [
        "id",
        "path",
        "mediaType",
        "wuPerAssetUnit",
        "size"
      ],
      "additionalProperties": false
    },
    "asset-scale": {
      "description": "WU per asset pixel or SVG viewBox unit; positive scale on the 1/65536 quantum.",
      "type": "number",
      "multipleOf": 0.0000152587890625,
      "exclusiveMinimum": 0,
      "maximum": 131072
    },
    "asset-size": {
      "description": "Decoded pixel size, SVG viewBox size, or [0, 0] for audio.",
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/asset-extent"
        },
        {
          "$ref": "#/$defs/asset-extent"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "asset-extent": {
      "type": "number",
      "multipleOf": 0.0625,
      "minimum": 0,
      "maximum": 131072
    },
    "deferred-array": {
      "$comment": "Contents validated from ML-004 to ML-006; ML-003 checks only the JSON type.",
      "type": "array"
    },
    "deferred-object": {
      "$comment": "Contents validated from ML-004 to ML-006; ML-003 checks only the JSON type.",
      "type": "object"
    },
    "vec": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/coordinate"
        },
        {
          "$ref": "#/$defs/coordinate"
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "positive-vec": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/length"
        },
        {
          "$ref": "#/$defs/length"
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "multipleOf": 0.0000152587890625
    },
    "alpha": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "multipleOf": 0.00390625
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$"
    },
    "body-shape": {
      "oneOf": [
        {
          "$ref": "#/$defs/rect-shape"
        },
        {
          "$ref": "#/$defs/polygon-shape"
        },
        {
          "$ref": "#/$defs/segment-shape"
        }
      ]
    },
    "rect-shape": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "rect"
        },
        "rect": {
          "$ref": "#/$defs/rect"
        }
      },
      "required": [
        "id",
        "kind",
        "rect"
      ],
      "additionalProperties": false
    },
    "polygon-shape": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "polygon"
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/vec"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "points"
      ],
      "additionalProperties": false
    },
    "segment-shape": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "segment"
        },
        "a": {
          "$ref": "#/$defs/vec"
        },
        "b": {
          "$ref": "#/$defs/vec"
        }
      },
      "required": [
        "id",
        "kind",
        "a",
        "b"
      ],
      "additionalProperties": false
    },
    "region-shape": {
      "oneOf": [
        {
          "$ref": "#/$defs/rect-region"
        },
        {
          "$ref": "#/$defs/polygon-region"
        },
        {
          "$ref": "#/$defs/circle-region"
        }
      ]
    },
    "rect-region": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "rect"
        },
        "rect": {
          "$ref": "#/$defs/rect"
        }
      },
      "required": [
        "kind",
        "rect"
      ],
      "additionalProperties": false
    },
    "polygon-region": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "polygon"
        },
        "points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/vec"
          }
        }
      },
      "required": [
        "kind",
        "points"
      ],
      "additionalProperties": false
    },
    "circle-region": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "circle"
        },
        "center": {
          "$ref": "#/$defs/vec"
        },
        "radius": {
          "$ref": "#/$defs/length"
        }
      },
      "required": [
        "kind",
        "center",
        "radius"
      ],
      "additionalProperties": false
    },
    "anchor": {
      "oneOf": [
        {
          "$ref": "#/$defs/world-anchor"
        },
        {
          "$ref": "#/$defs/surface-anchor"
        },
        {
          "$ref": "#/$defs/body-anchor"
        },
        {
          "$ref": "#/$defs/entity-anchor"
        }
      ]
    },
    "world-anchor": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "world"
        },
        "point": {
          "$ref": "#/$defs/vec"
        }
      },
      "required": [
        "kind",
        "point"
      ],
      "additionalProperties": false
    },
    "surface-anchor": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "surface"
        },
        "footholdId": {
          "$ref": "#/$defs/id"
        },
        "u": {
          "$ref": "#/$defs/unit"
        },
        "normalOffset": {
          "$ref": "#/$defs/coordinate"
        }
      },
      "required": [
        "kind",
        "footholdId",
        "u",
        "normalOffset"
      ],
      "additionalProperties": false
    },
    "body-anchor": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "body"
        },
        "bodyId": {
          "$ref": "#/$defs/id"
        },
        "point": {
          "$ref": "#/$defs/vec"
        }
      },
      "required": [
        "kind",
        "bodyId",
        "point"
      ],
      "additionalProperties": false
    },
    "entity-anchor": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "entity"
        },
        "entityId": {
          "$ref": "#/$defs/id"
        },
        "point": {
          "$ref": "#/$defs/vec"
        }
      },
      "required": [
        "kind",
        "entityId",
        "point"
      ],
      "additionalProperties": false
    },
    "call": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "params": {
          "$ref": "#/$defs/deferred-object"
        }
      },
      "required": [
        "key",
        "version",
        "params"
      ],
      "additionalProperties": false
    },
    "condition": {
      "$ref": "#/$defs/deferred-object"
    },
    "transform": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/vec"
        },
        "rotation": {
          "type": "number",
          "minimum": -35184372088831.996,
          "maximum": 35184372088831.996,
          "multipleOf": 0.00390625
        },
        "scale": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/asset-scale"
            },
            {
              "$ref": "#/$defs/asset-scale"
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": false
        },
        "mirrorX": {
          "type": "boolean"
        },
        "mirrorY": {
          "type": "boolean"
        }
      },
      "required": [
        "position",
        "rotation",
        "scale",
        "mirrorX",
        "mirrorY"
      ],
      "additionalProperties": false
    },
    "visual-source": {
      "oneOf": [
        {
          "$ref": "#/$defs/asset-source"
        },
        {
          "$ref": "#/$defs/shape-source"
        },
        {
          "$ref": "#/$defs/frames-source"
        }
      ]
    },
    "asset-source": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "asset"
        },
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "pivot": {
          "$ref": "#/$defs/vec"
        }
      },
      "required": [
        "kind",
        "assetId",
        "pivot"
      ],
      "additionalProperties": false
    },
    "shape-source": {
