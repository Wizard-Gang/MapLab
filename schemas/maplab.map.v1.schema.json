    },
    "paint-layer": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "parentId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "order": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "visible": {
          "type": "boolean"
        },
        "opacity": {
          "$ref": "#/$defs/alpha"
        },
        "kind": {
          "enum": [
            "tile",
            "sprite"
          ]
        },
        "occlusionFade": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/alpha"
